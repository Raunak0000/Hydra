{
    "manifest_version": 2,
    "name": "Hydra Advanced Download Interceptor",
    "version": "2.0.0",
    "description": "Enterprise-grade low-level header sniffing network interceptor for Hydra Core.",
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "cookies",
        "activeTab",
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": true
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "hydra-download-sniffer@raunak.local"
        }
    }
}