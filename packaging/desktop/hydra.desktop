[Desktop Entry]
Version=1.0
Type=Application
Name=Hydra Downloader
GenericName=Download Manager
Comment=High-speed multi-connection desktop download manager with live progress and scheduling
Exec=/usr/bin/hydra-gui --ensure-daemon
Icon=hydra
Terminal=false
StartupNotify=true
StartupWMClass=org.hydra.Downloader
Categories=Network;FileTransfer;GTK;
Keywords=download;manager;hydra;accelerator;gui;
Actions=NewDownload;BatchDownload;Settings;OpenDownloads;TrayController;

[Desktop Action NewDownload]
Name=New Download...
Exec=/usr/bin/hydra-gui --ensure-daemon --new-download

[Desktop Action BatchDownload]
Name=Batch Download...
Exec=/usr/bin/hydra-gui --ensure-daemon --batch-download

[Desktop Action Settings]
Name=Settings & Download Rules...
Exec=/usr/bin/hydra-gui --ensure-daemon --settings

[Desktop Action OpenDownloads]
Name=Open Downloads Folder
Exec=/usr/bin/hydra-tray --open-downloads

[Desktop Action TrayController]
Name=Start System Tray Controller
Exec=/usr/bin/hydra-tray
