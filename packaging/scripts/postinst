#!/bin/sh
set -e

# Update desktop entry and icon caches
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -q /usr/share/icons/hicolor || true
fi

# Enable systemd user unit globally so Hydra starts automatically after user login
if [ "$(id -u)" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl --global enable hydra.service >/dev/null 2>&1 || true

    # Start or restart the service immediately for the installing desktop user if active
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        SUDO_UID=$(id -u "$SUDO_USER" 2>/dev/null || true)
        RUNTIME_DIR="/run/user/$SUDO_UID"
        if [ -n "$SUDO_UID" ] && [ -S "$RUNTIME_DIR/bus" ] && command -v runuser >/dev/null 2>&1; then
            runuser -u "$SUDO_USER" -- env \
                XDG_RUNTIME_DIR="$RUNTIME_DIR" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME_DIR/bus" \
                systemctl --user daemon-reload >/dev/null 2>&1 || true
            runuser -u "$SUDO_USER" -- env \
                XDG_RUNTIME_DIR="$RUNTIME_DIR" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME_DIR/bus" \
                systemctl --user restart hydra.service >/dev/null 2>&1 || true
        fi
    fi
fi

exit 0
